# Copy this file to .env and fill in the values. .env is in .gitignore - never commit it.

# Required: bot token from https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=

# Recommended: your server ID (slash commands appear instantly instead of within an hour)
GUILD_ID=

# EXBO auction API. Production: set EXBO_CLIENT_ID + EXBO_CLIENT_SECRET and EXBO_API_BASE=https://eapi.stalzone.net
# Demo mode (test data only): set EXBO_API_TOKEN from the EXBO docs instead.
EXBO_CLIENT_ID=
EXBO_CLIENT_SECRET=
EXBO_API_TOKEN=
EXBO_API_BASE=https://dapi.stalzone.com

# Optional: path to the tesseract binary if it is not on PATH
# (on Windows the default install path is detected automatically)
# TESSERACT_CMD=

# Optional: folder for files the bot writes (prices, templates, databases). Docker sets this to /data.
# DATA_DIR=
